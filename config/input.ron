// Client-only: which physical key(s) trigger each PlayerAction. Add a
// new action to client::config::PlayerAction, then bind it here --
// nothing else needs to change. Key names match Bevy's KeyCode variants
// exactly (e.g. KeyW, ArrowUp, Space, ShiftLeft).
//
// These are the defaults. Players change their ability keys in the
// Abilities window; their changes are saved separately, in keybinds.ron
// in their settings folder (%APPDATA%\arpg-skeleton on Windows -- see
// client::config::keybindings_path), and this file is never rewritten.
(
    bindings: {
        MoveUp: [KeyW, ArrowUp],
        MoveDown: [KeyS, ArrowDown],
        MoveLeft: [KeyA],
        MoveRight: [KeyD],
        // Left/right arrow no longer duplicate MoveLeft/MoveRight -- they
        // instead rotate a charging bow's aim (see
        // game_core::components::RotateInput), independent of AWSD
        // movement.
        RotateLeft: [ArrowLeft],
        RotateRight: [ArrowRight],
        Jump: [Space],
        Attack: [KeyF],
        // Slots 0-3 (the four elemental Transformations) on the number
        // row; slots 4-5 (the two Active test abilities) on Q/R -- see
        // game_core::systems::combat::TEST_ABILITY_SLOTS for which
        // ability id currently occupies each.
        Ability1: [Digit1],
        Ability2: [Digit2],
        Ability3: [Digit3],
        Ability4: [Digit4],
        Ability5: [KeyQ],
        Ability6: [KeyR],
        Interact: [KeyE],
        Cancel: [Escape],
    },
)
