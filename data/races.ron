// Data-driven race list. Adding a race is adding an entry here (id ->
// display name + attribute deltas + stat modifiers) plus a
// gallery/characters/<id> sprite folder -- no code change, no recompile.
//
// attribute_modifiers is this race's deltas from stats::BASE_ATTRIBUTE_
// VALUE (4) -- every character's actual Strength/Dexterity/Agility/
// Intelligence/Wisdom/Vitality is 4 + whatever's listed here (missing
// fields default to 0). See stats::DerivedStats::from_attributes for how
// those turn into ATT/DEF/crit/speeds/etc.
//
// modifiers is the separate, smaller grab-bag of misc racial bonuses that
// don't come from an attribute at all -- day_vision/night_vision are
// real: a flat racial bonus/malus (world units) added on top of
// GameplayConfig::vision_radius_day/_night respectively by
// systems::vision::recompute_vision_radius, independently (a race can
// differ at noon without differing after dark, or vice versa).
// dark_vision is the same for a floor daylight never reaches (a tunnel),
// on top of GameplayConfig::vision_radius_dark at any hour.
//
// Pools: max_health (default 100), max_mana (default 0), max_stamina
// (default 100) and max_faith (default 0) are each race's base, before
// its attributes add their share (Vitality: health and stamina;
// Intelligence: mana; Wisdom: faith -- see stats::DerivedStats).
// damage/defense/magic_attack are a flat ATT/DEF/MATT bonus folded into
// DerivedStats on top of the attribute formula's own output -- still all
// zero below, nothing differentiates races there beyond their attributes
// yet.
//
// `id` here (the map key) is the RaceId every CharacterRace component and
// gallery/characters/<id> folder name must match exactly.
//
// Starting numbers below are a first guess, not a final balance pass --
// tune freely, just a RON edit + restart, no recompile needed.
(
    races: {
        "human": (
            display_name: "Human",
            // Baseline -- no attribute delta, no modifier of its own; the
            // -300 that used to sit here belonged to the shared base
            // (GameplayConfig::vision_radius_day), not to humans
            // specifically, so it moved there instead of needing to be
            // repeated on every other race too.
            modifiers: (day_vision: 0.0),
            // A modest starting pool so the default playable race can
            // actually cast a mana-costing ability out of the box --
            // tune freely, just a RON edit + restart.
            max_mana: 50,
        ),
        "orc": (
            display_name: "Orc",
            attribute_modifiers: (strength: 2, vitality: 1, intelligence: -2, wisdom: -2),
            modifiers: (day_vision: 0.0),
        ),
        "elf": (
            // Keen-eyed generally, not just after dark -- day_vision on
            // top of the existing night_vision bonus.
            display_name: "Elf",
            attribute_modifiers: (strength: -1, agility: 2, wisdom: 2, vitality: -1),
            // A little better than a human underground, far from a dwarf.
            modifiers: (night_vision: 60.0, day_vision: 50.0, dark_vision: 30.0),
        ),
        "dwarf": (
            // Cave-dweller trope: a little worse in open daylight, the
            // best of every race underground. No matching night_vision
            // bonus yet -- add one if that's the direction you want to
            // take this, purely a data change.
            display_name: "Dwarf",
            attribute_modifiers: (strength: 1, agility: -1, vitality: 1),
            modifiers: (day_vision: -40.0, dark_vision: 150.0),
        ),
    },
)
