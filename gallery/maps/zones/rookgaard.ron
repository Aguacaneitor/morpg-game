    npcs: [
        // A few tiles south of the player's own respawn point
        // (config/gameplay.ron's respawn_position, ~row 104/col 142 at
        // this zone's tile_size) -- close enough to be immediately
        // visible on spawning in, without sitting on top of the chest
        // (row 105/col 141) or the ladder (row 103/col 141).
        //
        // NOT (row: 104, col: 145) -- that spot (this comment's own
        // former home) sits in a tight alcove with a wall directly on
        // its north side (row 103, col 145) and another immediately east
        // (row 104, col 146). `systems::npc_wander::tick_npc_wander`
        // picks a random point within `NpcDefinition::wander_radius` of
        // home with no solidity check of its own (same as a creature's
        // own wander target picking -- see `systems::wander`), so a home
        // this boxed-in kept rolling unreachable targets just past a
        // wall; the entity would walk straight at one, get stopped dead
        // by collision, and -- since it never actually arrives -- keep
        // recomputing velocity toward that same stuck target every tick
        // instead of ever picking a new one, which is exactly what read
        // as "always tries to walk north no matter how far you push him
        // south". (row: 108, col: 142) has a fully open 5x5-tile
        // neighborhood (checked against `game_core::map::
        // non_solid_local_cells`), comfortably past `wander_radius`
        // (80 units / 64-unit tiles ~= 1.25 tiles), so wandering here
        // never rolls an unreachable target in the first place.
        (npc: "lucas", row: 130, col: 142),
    ],
)
