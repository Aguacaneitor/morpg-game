        // The north bridge's own ladder art -- used at both ends (see
        // the "objects"/"bridge_objects" layers below and `stairs`
        // above): the town-side ladder painted as an overlay on top of
        // the plain road tile at (103, 141), and the bridge's own north
        // ladder at floor 1. Always an overlay on a decoration
        // (`height: 1`) layer, never placed directly into a "ground"
        // layer -- doing that once actually *replaced* the ground tile
        // underneath instead of drawing over it, which is exactly what
        // painting it on its own layer (same trick the "objects" layer
        // already uses for every other prop) avoids.
        8: (
            render_size: (64.0, 64.0),
            solid: false,
            vission_block: false,
            light_source: false,
            light_radius: 0.0,
            // Single static frame, not a real animation -- see
            // `gallery/objects/terrain/stairs/wodden_ladder/0001.png`
            // (a plain copy of the flat `wodden_ladder.png` this was
            // authored as, folded into the one-frame-per-file folder
            // convention every `object_name` tile already needs).
            object_name: "terrain/stairs/wodden_ladder",
            frame_count: 1,
            object_fps: 8.0,
            // Terrain, not a discoverable prop -- a ladder is part of the
            // map layout (you should always be able to see it, including
            // through a gap from the floor above, same as any ordinary
            // tile), not something that hides until explored the way a
            // bonfire does. See `TileDefinition::vision_gated`'s own doc.
            vision_gated: false,
            hitbox_shape: Square,
            hitbox_dimension: (0.0, 0.0),
            hitbox_init_position: (0.0, 0.0),
            biome: "",
            autotile: None,
            autotile_from_registry: false,
            painting_order: None,
        ),
        // The north bridge's own deck -- a plain wood-floor tile, laid
        // down across the "bridge_deck" layer below (floor 1). Its own
        // ladders (tile 8, above) are a separate overlay layer
        // ("bridge_objects") on top of this, same "ground tile stays
        // visible underneath" reasoning as tile 8's own doc.
