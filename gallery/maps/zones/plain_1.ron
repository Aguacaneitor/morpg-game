        5: (atlas: "tiles/plain_1/objects/grass_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: false, vission_block: false),
        6: (atlas: "tiles/plain_1/objects/grass_2.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: false, vission_block: false),
        7: (atlas: "tiles/plain_1/objects/grass_3.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: false, vission_block: false),
        8: (atlas: "tiles/plain_1/objects/grass_4.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: false, vission_block: false),
        9: (atlas: "tiles/plain_1/objects/grass_5.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: false, vission_block: false),
        10: (atlas: "tiles/plain_1/objects/dry_stump_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: false),
        11: (atlas: "tiles/plain_1/objects/log_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: false),
        12: (atlas: "tiles/plain_1/objects/medium_bush_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: false),
        // hitbox_init_position (49.0, 41.5) centers this 30x45 box on the
        // tile -- without it, hitbox_dimension alone anchors growth from
        // the sprite's own bottom-left corner (see TileDefinition::hitbox's
        // own doc), which for a 128x128 sprite left the actual hitbox
        // sitting almost entirely in one corner instead of on the trunk.
        // rect below is now the *declared atlas image size* (128x64, the
        // whole 2-frame test sheet), not a single frame -- see
        // TileDefinition::painting_order's own doc. painting_order is a
        // list, not a map keyed by number: RON map syntax needs `{}` (a
        // bare `1:`/`2:` key inside `()` isn't valid RON for either a map
        // or a struct, since struct field names can't be plain digits) --
        // a plain ordered list needs no key at all, since paint order
        // among same-band parts isn't meaningful anyway.
        13: (atlas: "tiles/plain_1/objects/pine_tree_parts.png", rect: (0, 0, 128, 64), render_size: (128.0, 128.0), solid: true, vission_block: true, hitbox_shape: Rectangle, hitbox_dimension: (14.0, 30.0), hitbox_init_position: (55.0, 12.0), painting_order: Some([
            (rect: (0, 0, 64, 64), paint_after_creatures: false),
            (rect: (64, 0, 64, 64), paint_after_creatures: true, paint_after_shadow: true),
        ])),
        14: (atlas: "tiles/plain_1/objects/regular_stump_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: false),
        15: (atlas: "tiles/plain_1/objects/regular_tree_1_parts.png", rect: (0, 0, 64, 64), render_size: (128.0, 128.0), solid: true, vission_block: true, hitbox_shape: Rectangle, hitbox_dimension: (30.0, 35.0), hitbox_init_position: (49.0, 5.0), painting_order: Some([
            (rect: (0, 0, 64, 64), paint_after_creatures: false),
            (rect: (64, 0, 64, 64), paint_after_creatures: true, paint_after_shadow: true),
        ])),
        16: (atlas: "tiles/plain_1/objects/rock_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: false),
        17: (atlas: "tiles/plain_1/objects/rock_pile_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: false),
        18: (atlas: "tiles/plain_1/objects/small_bush_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: false),
        19: (atlas: "tiles/plain_1/objects/sticks_pile_1.png", rect: (0, 0, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: false),
