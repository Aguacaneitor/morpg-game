// First map generated by noise with the scrip on morpg-game\map_generator
(
    name: "Plains number 1",
    tile_size: 64.0,
    tiles: {
        // IDs start at 1, not 0 -- the engine reserves tile id 0
        // globally to mean "empty cell, nothing here" (client/server/
        // World::stitch all skip it outright), so a biome using 0 would
        // render as an invisible hole instead of an actual tile. See
        // map_generator's own noise_to_tile doc for the same rule on the
        // generation side.
        //
        // 1/2 (deep/shallow water) both blend against sand via the 3x3
        // blob at water_sand.png's own top-left 3x3 block (cols/rows
        // 0-2, 64px cells) -- `rect` still points at the plain center
        // piece as a fallback/size reference, but `autotile` is what
        // actually picks a sub-rect per cell once a `biome` neighbor
        // check runs (see core::map::AutotileBlob and
        // client::map::resolve_autotile_index). Sand (3) deliberately
        // has no `biome` of its own -- it doesn't need edges, water's
        // own blob already paints the transition onto *its* tiles, and
        // "no biome" is exactly what makes sand read as "different" to
        // water's neighbor check.
        1: (atlas: "tiles/plain_1/water_sand.png", rect: (64, 64, 64, 64), render_size: (64.0, 64.0), solid: false, biome: "water", autotile: Some((
            center: (64, 64, 64, 64),
            top: (64, 0, 64, 64),
            bottom: (64, 128, 64, 64),
            left: (0, 64, 64, 64),
            right: (128, 64, 64, 64),
            top_left: (0, 0, 64, 64),
            top_right: (128, 0, 64, 64),
            bottom_left: (0, 128, 64, 64),
            bottom_right: (128, 128, 64, 64),
        ))),
        2: (atlas: "tiles/plain_1/forest_grass.png", rect: (64, 128, 64, 64), render_size: (64.0, 64.0), solid: false, biome: "forest", autotile: Some((
            center: (64, 64, 64, 64),
            top: (64, 0, 64, 64),
            bottom: (64, 128, 64, 64),
            left: (0, 64, 64, 64),
            right: (128, 64, 64, 64),
            top_left: (0, 0, 64, 64),
            top_right: (128, 0, 64, 64),
            bottom_left: (0, 128, 64, 64),
            bottom_right: (128, 128, 64, 64),
        ))),
        3: (atlas: "tiles/plain_1/forest_grass.png", rect: (64, 128, 64, 64), render_size: (64.0, 64.0), solid: false, biome: "forest", autotile: Some((
            center: (64, 64, 64, 64),
            top: (64, 0, 64, 64),
            bottom: (64, 128, 64, 64),
            left: (0, 64, 64, 64),
            right: (128, 64, 64, 64),
            top_left: (0, 0, 64, 64),
            top_right: (128, 0, 64, 64),
            bottom_left: (0, 128, 64, 64),
            bottom_right: (128, 128, 64, 64),
        ))),
        4: (atlas: "tiles/plain_1/grass_mud.png", rect: (64, 128, 64, 64), render_size: (64.0, 64.0), solid: true, vission_block: true, biome: "clift", autotile: Some((
            center: (64, 128, 64, 64),
            top: (64, 0, 64, 64),
            bottom: (64, 256, 64, 64),
            left: (0, 128, 64, 64),
            right: (128, 128, 64, 64),
            top_left: (0, 0, 64, 64),
            top_right: (128, 0, 64, 64),
            bottom_left: (0, 256, 64, 64),
            bottom_right: (128, 256, 64, 64),
