// The "encapsulating" file: lists zones and where each one's local
// (0,0) lands in the world's global tile-coordinate system. Zone files
// never know their own placement -- only this manifest does, so a zone
// can be moved, reused, or added without touching any other zone.
(
    name: "Overworld",
    zones: [

        // Rookgaard's own local (0,0) at global (0,0) -- no other zone is
        // active right now to line up against, so there's no reason to
        // offset it. See docs/adding-a-zone.md and map_generator's own
        // `tibia-import` mode for how this was generated (layout only,
        // from the public tibiamaps/tibia-map-data repo -- reusing
        // rook_town.ron's own already-authored tile art, not any actual
        // Tibia game asset).
        (file: "zones/rookgaard.ron", offset: (0, 0)),
        //(file: "zones/pipoya_demo.ron", offset: (0, 0)),

        // pipoya_demo is 60x60 tiles -- offset col 65 leaves a 5-tile
        // gap to its east so the two don't touch/overlap. Both zones are
        // authored at world tile_size 32 now (pipoya_48_demo was
        // re-targeted down from its own 48px-native scale at import time
        // -- see map_generator's own `pipoya-import` mode, its
        // `target_tile_size` argument), so they line up on the same grid
        // correctly despite the source art itself staying native-48px.
        //(file: "zones/pipoya_48_demo.ron", offset: (0, 65)),

        // The north bridge (floor 1, over the town's own north wall) is
        // authored right inside zones/rookgaard.ron itself now -- its own
        // "bridge_deck"/"bridge_objects" layers set `floor: 1` directly,
        // so no second `ZonePlacement` entry (and no separate offset
        // arithmetic) is needed for it at all. See `MapLayer::floor`'s
        // own doc for why one zone file can mix floors like this.

        // Commented out, not deleted -- switch back by uncommenting this
        // and commenting the entry above, same "remove without deleting"
        // convention docs/adding-a-zone.md documents.
        //(file: "zones/rook_town.ron", offset: (-40, -60)),

        // forest_clearing is 120x80 tiles. offset = (-40, -60) puts its
        // own center at global (0,0), matching where it used to sit
        // back when it was the only map -- players still spawn in the
        // plaza.
        
        //(file: "zones/forest_clearing.ron", offset: (-40, -60)),
        
        // forest_clearing's south wall (its local row 79) has a 12-tile
        // opening at local cols 17-28, i.e. global cols -43..-32 once
        // placed above. south_grove is 40x80; offset row 40 puts its
        // top row immediately below that wall (global row 39 is
        // forest_clearing's last row, so 40 is flush with no gap), and
        // offset col -57 centers its width under the opening
        // (-57 + 19.5 =~ -37.5, the opening's own center).
        
        //(file: "zones/south_grove.ron", offset: (40, -57)),
        
        // south_grove is 40 cols wide (-57..-18), so col -17 sits flush
        // against its right (east) edge. Row 40 matches south_grove's
        // own top row, which is itself flush with forest_clearing's
        // south wall (row 39 is forest_clearing's last row) -- so
        // forest_laberinth's top-left corner lands directly below
        // forest_clearing and directly right of south_grove, touching
        // both with no gap and no overlap.
        
        //(file: "zones/forest_laberinth.ron", offset: (40, -17)),
    ],
)
